    <key>NSMicrophoneUsageDescription</key>
    <string>KeyVoice records your voice while you hold the push-to-talk key, transcribes it on your Mac, and types the result.</string>
    <!-- On-device speech recognition. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>KeyVoice transcribes your dictation on-device to type it at your cursor.</string>
</dict>
</plist>
